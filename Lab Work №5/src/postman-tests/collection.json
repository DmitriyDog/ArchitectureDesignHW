    {
      "name": "Проверка счётчика",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Получаем текущее значение\r",
              "let responseText = pm.response.text();\r",
              "let match = responseText.match(/(\\d+)/);\r",
              "if (match) {\r",
              "    let count = parseInt(match[0]);\r",
              "    pm.environment.set(\"lastCount\", count);\r",
              "}\r",
              "\r",
              "pm.test(\"Response contains a number\", function() {\r",
              "    pm.expect(match).to.not.be.null;\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
